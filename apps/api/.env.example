DATABASE_URL="postgresql://budget_manager:budget_manager@localhost:5432/budget_manager?schema=public"
JWT_SECRET="change-me"
JWT_ACCESS_TTL="15m"
REFRESH_TTL="30d"
ARGON_MEMORY_COST="19456"
UPLOAD_MAX_BYTES="10485760"
UPLOAD_RETENTION_DAYS="30"
AUDIT_RETENTION_MONTHS="24"
EXCHANGE_RATE_PROVIDER=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""
IP_HASH_SALT="change-me"
LOG_LEVEL="info"
PORT="3000"
# Comma-separated allowed origins for CORS. Required in production - empty only reflects
# the request origin, which is fine for local dev but must never ship to prod like that.
CORS_ORIGIN="https://your-frontend-domain.example"
# SMTP for transactional email (password reset, etc). Empty SMTP_HOST disables sending
# (logs a warning instead) - fine for local dev, required in production.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Mr Wallet <no-reply@mister-wallet.com>"
# Base URL of the web app, used to build the link inside the password reset email.
WEB_APP_URL="http://localhost:3001"
