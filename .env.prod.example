# Copy to `.env` at repo root and fill in real values before running
# docker-compose.prod.yml. Never commit the real `.env`.

# Full connection string. With Neon, use the UNPOOLED url (this schema uses the same
# string for migrations and runtime queries - pooled/PgBouncer can break prepared statements).
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Only used if you self-host Postgres via the `local-db` compose profile instead of
# Neon - see docker-compose.prod.yml. Not needed with Neon.
# POSTGRES_USER=budget_manager
# POSTGRES_PASSWORD=change-me-generate-a-real-password
# POSTGRES_DB=budget_manager

# openssl rand -base64 48
JWT_SECRET=change-me-generate-a-real-secret
# openssl rand -base64 32
IP_HASH_SALT=change-me-generate-a-real-salt

# Real front-end domain(s), comma-separated, no trailing slash. Never leave empty in prod.
CORS_ORIGIN=https://your-frontend-domain.example

# Domain the API is served on - Caddy requests/renews its Let's Encrypt cert for this.
# Must already point (DNS A record) at this server before starting caddy.
API_DOMAIN=api.your-domain.example

# Public URL the browser will call for the API.
NEXT_PUBLIC_API_URL=https://api.your-domain.example/api/v1

# Web Push - required in production (boot fails if empty). Generate with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=change-me-generate-a-real-vapid-public-key
VAPID_PRIVATE_KEY=change-me-generate-a-real-vapid-private-key
VAPID_SUBJECT=mailto:admin@your-domain.example

# Error monitoring (optional - leave empty to disable Sentry).
SENTRY_DSN=

# SMTP - required in production (boot fails if empty). Used to send password-reset
# and email-verification mail.
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_USER=no-reply@your-domain.example
SMTP_PASS=change-me-generate-a-real-password
SMTP_FROM=Mr Wallet <no-reply@your-domain.example>

# Front-end URL used to build links inside emails (reset/verify).
WEB_APP_URL=https://your-frontend-domain.example
