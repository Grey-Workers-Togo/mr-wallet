# Copy to `.env` at repo root and fill in real values before running
# docker-compose.prod.yml. Never commit the real `.env`.

POSTGRES_USER=budget_manager
POSTGRES_PASSWORD=change-me-generate-a-real-password
POSTGRES_DB=budget_manager

# openssl rand -base64 48
JWT_SECRET=change-me-generate-a-real-secret
# openssl rand -base64 32
IP_HASH_SALT=change-me-generate-a-real-salt

# Real front-end domain(s), comma-separated, no trailing slash. Never leave empty in prod.
CORS_ORIGIN=https://your-frontend-domain.example

# Public URL the browser will call for the API.
NEXT_PUBLIC_API_URL=https://api.your-domain.example/api/v1

# Web Push (optional - leave empty to keep push notifications disabled).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.example
